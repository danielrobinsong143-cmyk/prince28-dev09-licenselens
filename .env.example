
# Copy this file to .env and fill in real values.
# .env is never committed.

APP_NAME=licenselens
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Put your actual Neon connection string in .env only.
DATABASE_URL=postgresql://localhost:5432/licenselens

# LLM keys (Day 8)
GEMINI_API_KEY=
GROQ_API_KEY=

LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Queue and worker (Day 10). On your laptop Redis comes from: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Whoever sends this value in the X-Admin-Token header may start an ingestion.
ADMIN_TOKEN=

# true only where there is no separate worker service (Render free): the API runs the worker.
WORKER_IN_API=false
